/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

