// Resume only the persistent local verification database; no production client.
import{PGlite}from'@electric-sql/pglite';import{readFile,writeFile,readdir}from'node:fs/promises';import{resolve}from'node:path';
import{supplierAdapter}from'../src/lib/supplier-tracker/adapters';import{fetchTrackerHtml}from'../src/lib/supplier-tracker/network';import{pageFingerprint,normalizeSourceCost}from'../src/lib/supplier-tracker/worker';
const folder=resolve(process.argv[2]??'');
const root=resolve('scratch/suppliers-private');if(!folder.startsWith(root+'\\')&&!folder.startsWith(root+'/'))throw Error('Local private verification directory required');
const report=JSON.parse(await readFile(resolve(folder,'report.json'),'utf8')),adapter=supplierAdapter(report.source.key),db=new PGlite(resolve(folder,'postgres'));let page=(await readdir(folder)).filter(f=>/^page-\d+\.html$/.test(f)).length;
try{const deadline=Date.now()+8*60000;while(Date.now()<deadline){await db.exec("reset role;update supplier_tracker_tasks set next_run_at=now()+interval '1 day'where kind='monitor';update supplier_source_slots set next_at=now()-interval '1 second';set role service_role");const tasks=(await db.query<{id:string;url:string;kind:string;lease_token:string}>('select *from tracker_claim_tasks_v1(4)')).rows;if(!tasks.length)break;for(const t of tasks){if(t.kind!=='discover')continue;await new Promise(r=>setTimeout(r,10000));const html=await fetchTrackerHtml(t.url,adapter.key),listing=adapter.listing(html,t.url,report.source.url);const file=resolve(folder,'page-'+(++page)+'.html');await writeFile(file,html);report.pages.push({url:t.url,file});const data={products:listing.products.map(p=>({...p,...normalizeSourceCost(p,{})})),pages:listing.pages,contentHash:await pageFingerprint(listing.products)};await db.query('select tracker_record_page_v1($1,$2,$3)',[t.id,t.lease_token,data]);console.log(JSON.stringify({page,identities:listing.products.length}));}}
 report.resumedAt=new Date().toISOString();report.run=(await db.query('select *from supplier_tracker_runs order by started_at limit 1')).rows[0];report.persistedItems=(await db.query<{n:number}>('select count(*)::int n from supplier_tracker_items')).rows[0].n;
 await db.exec('reset role');const sourceId=(await db.query<{id:string}>('select id from supplier_tracker_sources limit 1')).rows[0].id;
 if(report.run.state==='done'){
  await db.exec('set role service_role');const run=(await db.query<{id:string}>('select tracker_start_source_v1($1)id',[sourceId])).rows[0].id;let replay=0;
  const parsed=new Map<string,unknown>();
  for(const captured of report.pages){const html=await readFile(captured.file,'utf8');const l=adapter.listing(html,captured.url,report.source.url);parsed.set(captured.url,{products:l.products.map(p=>({...p,...normalizeSourceCost(p,{})})),pages:l.pages,contentHash:await pageFingerprint(l.products)});}
  while(replay<page){await db.exec("reset role;update supplier_tracker_tasks set next_run_at=now()+interval '1 day'where kind='monitor';update supplier_source_slots set next_at=now()-interval '1 second';set role service_role");const tasks=(await db.query<{id:string;url:string;kind:string;lease_token:string}>('select *from tracker_claim_tasks_v1(4)')).rows;if(!tasks.length)break;for(const t of tasks){if(t.kind!=='discover')continue;const data=parsed.get(t.url);if(!data)throw Error('No unambiguous captured response for replay URL');await db.query('select tracker_record_page_v1($1,$2,$3)',[t.id,t.lease_token,data]);replay++;}}
  report.replay=(await db.query('select *from supplier_tracker_runs where id=$1',[run])).rows[0];
 }
 await writeFile(resolve(folder,'report-resumed.json'),JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));
}finally{await db.close();}
