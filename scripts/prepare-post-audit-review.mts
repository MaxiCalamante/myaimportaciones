// SELECT only. Produce exact review targets, never execute the repair proposals.
import{createClient}from'@supabase/supabase-js';import{mkdir,writeFile}from'node:fs/promises';import{resolve}from'node:path';import{readAllPages}from'../src/lib/read-all-pages';import{sourceUrl,supplierKeyForUrl}from'../src/lib/supplier-url-policy';
const url=process.env.NEXT_PUBLIC_SUPABASE_URL,key=process.env.SUPABASE_SERVICE_ROLE_KEY;if(!url||!key)throw Error('Private configuration required');const db=createClient(url,key,{auth:{persistSession:false,autoRefreshToken:false}});
type Row=Record<string,unknown>;const all=(table:string,order='id')=>readAllPages<Row>((from,to)=>db.from(table).select('*').order(order).range(from,to));
const[products,variants,costs,offers,suppliers,jobs]=await Promise.all([all('products'),all('product_variants'),all('product_costs','product_id'),all('supplier_offers'),all('suppliers'),all('supplier_sync_queue')]);
const active=products.filter(p=>p.is_active&&!p.deleted_at),retained=new Set(suppliers.filter(s=>s.is_active&&!s.archived_at).map(s=>s.id));
const missing=active.filter(p=>p.fulfillment_mode==='supplier'&&!p.source_url&&!offers.some(o=>o.product_id===p.id&&retained.has(o.supplier_id)&&!o.archived_at)).map(p=>{const c=costs.find(c=>c.product_id===p.id);let candidate:string|null=null;try{if(c?.supplier_url)candidate=sourceUrl(String(c.supplier_url),String(c.supplier_url),supplierKeyForUrl(String(c.supplier_url)));}catch{}return{productId:p.id,title:p.title,costUrlCandidate:candidate,verifiedAt:c?.verified_at??null,action:candidate?'Revisar ficha e identidad exacta con matcher existente antes de restaurar URL y vínculo':'Obtener ficha exacta de un proveedor retenido; no usar coincidencia de título',approved:false};});
const flags=active.filter(p=>!p.has_variants&&variants.some(v=>v.product_id===p.id&&v.is_active)).map(p=>({productId:p.id,title:p.title,proposedHasVariants:true,activeVariantIds:variants.filter(v=>v.product_id===p.id&&v.is_active).map(v=>v.id),approved:false}));
const missingWholesale=variants.filter(v=>v.is_active&&active.some(p=>p.id===v.product_id)&&!(Number(v.wholesale_price)>0)).map(v=>({productId:v.product_id,variantId:v.id,title:v.title,action:'Completar costo y precio propio de la variante; no copiar precio/costo del padre',approved:false}));
const queues=jobs.filter(j=>j.state==='blocked'&&retained.has(j.supplier_id)).map(j=>{const message=String(j.last_error??'');return{id:j.id,supplierId:j.supplier_id,supplier:suppliers.find(s=>s.id===j.supplier_id)?.name,productId:j.product_id,variantId:j.variant_id??null,url:j.source_url,error:message,plan:/404|not found/i.test(message)?'Volver a consultar ficha pública; conservar desconocido, nunca inferir agotamiento de 404':/variante|variant|relink|v.ncul|identity|identidad|t.tulo|title/i.test(message)?'Revisión manual de identidad/variante y enlace exacto; no desbloquear por similitud':/costo|cost|moneda|currency|eviden|USD|stock/i.test(message)?'Renovar evidencia primaria de moneda, costo y disponibilidad antes de reencolar':'Revisar causa técnica o URL; mantener bloqueo hasta evidencia suficiente',approved:false};});
const output=resolve('scratch/suppliers-private/post-audit-2026-11-06/review');await mkdir(output,{recursive:true});const summary={at:new Date().toISOString(),mode:'SELECT only, proposed repairs not executed',productsMissingUrlAndRetainedOffer:missing.length,withCostUrlCandidate:missing.filter(p=>p.costUrlCandidate).length,parentFlags:flags.length,variantsMissingWholesale:missingWholesale.length,blockedBySupplier:Object.fromEntries(suppliers.filter(s=>retained.has(s.id)).map(s=>[String(s.name),queues.filter(j=>j.supplierId===s.id).length]))};await writeFile(resolve(output,'review.json'),JSON.stringify({summary,missing,flags,missingWholesale,queues},null,2));console.log(JSON.stringify({output,...summary},null,2));
