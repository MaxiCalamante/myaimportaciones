NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
COMMERCE_CHECKOUT_ENABLED=false
# Additional transfer discount (0-5%). Applied only within verified product margin.
TRANSFER_DISCOUNT_PERCENT=3

# Transactional emails (disabled until an owned domain is verified in Resend).
# Use a NEW private API key; never use a key exposed in chat or commit a secret.
TRANSACTIONAL_EMAILS_ENABLED=false
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=false
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=maximocalamante14@gmail.com
# Administrators verified in the store database on 2026-10-19.
ADMIN_NOTIFICATION_EMAILS=maximocalamante14@gmail.com,agustinagil009@gmail.com
RESEND_WEBHOOK_SECRET=
# Shared cron bearer secret. Resend webhook uses its own signing secret above.
CRON_SECRET=
# Correo Argentino - API 2.0 (Paq.ar REST)
# Credenciales comerciales provistas por Correo Argentino
CORREO_ARGENTINO_API_KEY=
CORREO_ARGENTINO_AGREEMENT=
CORREO_ARGENTINO_ENV=test # test o production

# Políticas de envío:
# correo_argentino: usa tarifas configuradas; no es un cotizador API en vivo por paquete/origen.
# quote_separately: cobra productos ahora y cotiza el envío por separado
NEXT_PUBLIC_SHIPPING_PAYMENT_POLICY=correo_argentino

# Enable shipping calculation and payment online
COMMERCE_SHIPPING_ENABLED=true

# Confirmed supplier home-delivery rates (ARS) by destination, packages <=2kg.
# Keys: local_tandil, caba, gba, buenos_aires_interior, centro_litoral, cuyo_noa, patagonia, argentina_general
NEXT_PUBLIC_SUPPLIER_SHIPPING_RATES_JSON={"local_tandil":2500,"caba":6800,"gba":7200,"buenos_aires_interior":7800,"centro_litoral":8600,"cuyo_noa":9800,"patagonia":12500,"argentina_general":8900}


# Optional: use only the real verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=
